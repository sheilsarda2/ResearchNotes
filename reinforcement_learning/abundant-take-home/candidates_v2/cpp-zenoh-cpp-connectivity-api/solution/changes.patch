+            std::cout << "    src: " << link.get_src() << "\n";
+            std::cout << "    dst: " << link.get_dst() << "\n";
+        },
+        []() {});
+
+    while (true) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
