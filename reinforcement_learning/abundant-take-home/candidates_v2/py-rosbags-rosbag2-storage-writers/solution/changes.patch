+def write_record(bio: BinaryIO, op_: int, record: BytesIO) -> None:
+    """Write record."""
+    bio.write(op_.to_bytes(1, byteorder='little'))
+    write_uint64(bio, record.tell())
+    bio.write(record.getbuffer())
