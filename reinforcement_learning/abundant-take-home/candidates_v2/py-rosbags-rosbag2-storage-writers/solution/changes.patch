+def write_schema(bio: BinaryIO, schema: Schema) -> None:
+    """Write schema."""
+    rec = BytesIO()
+    write_uint16(rec, schema.id)
+    write_string(rec, schema.name)
+    write_string(rec, schema.encoding)
+    write_string(rec, schema.data)
+    write_record(bio, 0x03, rec)
+
