+@cli.command(name="import-resumable")
+@click.argument("path", type=click.Path(dir_okay=False, allow_dash=False))
+@click.argument("table")
+@click.argument("file", type=click.Path(exists=True, dir_okay=False, allow_dash=False))
+@click.option("--import-id", required=True, help="Persistent identity for this import")
+@click.option("--batch-size", type=click.IntRange(min=1), default=100, show_default=True)
+@click.option("--pk", multiple=True, help="Primary key column (repeat for compound keys)")
+@click.option("--alter", is_flag=True, help="Add columns when new fields appear")
+@click.option("--upsert", is_flag=True, help="Update rows with matching primary keys")
+def import_resumable(path, table, file, import_id, batch_size, pk, alter, upsert):
+    """Import a local UTF-8 NDJSON FILE with durable batch checkpoints."""
+    try:
+        db = sqlite_utils.Database(path)
+        _register_db_for_cleanup(db)
+        result = db.table(table).insert_file_resumable(
+            file, import_id=import_id, batch_size=batch_size,
+            pk=list(pk) if pk else None, alter=alter, upsert=upsert,
+        )
+    except (
+        ValueError, OSError, sqlite3.Error, NoTable, InvalidColumns,
+        PrimaryKeyRequired, AlterError, TransactionError,
+    ) as ex:
+        raise click.ClickException(str(ex)) from ex
+    click.echo(json.dumps(result, ensure_ascii=False))
+
