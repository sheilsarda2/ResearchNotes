+    def __init__(self, *args, failure_archive=False, **kwargs):
+        self.failure_archive = failure_archive
+        if failure_archive:
+            if str(kwargs.get('filename', 'huey.db')) == ':memory:':
+                raise ConfigurationError('failure archive requires on-disk SQLite')
+            kwargs['failure_archive'] = True
+        super(SqliteHuey, self).__init__(*args, **kwargs)
+        if failure_archive:
+            storage = (self.storage if isinstance(self.storage, SqliteStorage)
+                       else self.get_storage(**self.storage_kwargs))
+            if not isinstance(storage, SqliteStorage):
+                raise ConfigurationError('failure archive requires SQLite storage')
+            from huey.contrib.deadletter import FailureArchive
+            self._failure_archive = FailureArchive(self, storage)
+
+    def _archive(self):
+        if not self.failure_archive:
+            raise ConfigurationError('failure_archive is not enabled')
+        return self._failure_archive
+
+    def _snapshot_failure(self, task):
+        if self.failure_archive and not isinstance(task, PeriodicTask):
+            return self.serialize_task(copy.deepcopy(task))
+
+    def _record_failure(self, task, exception, snapshot):
+        if snapshot is not None:
+            self._archive().record(snapshot, self.build_error_result(task, exception))
+
+    def failures(self, limit=100, after=None):
+        return self._archive().failures(limit, after)
+
+    def failure(self, failure_id):
+        return self._archive().failure(failure_id)
+
+    def redrive(self, failure_id, retries=0, delay=None, priority=None):
+        return self._archive().redrive(failure_id, retries, delay, priority)
+
+    def delete_failure(self, failure_id):
+        return self._archive().delete_failure(failure_id)
+
