+Reservation = namedtuple('Reservation', ('token', 'data', 'expires_at'))
+
+
+class LeasedSqliteStorage(SqliteStorage):
+    """SQLite delivery with durable, generation-fenced reservations.
+
+    Task rows remain present until acknowledged. A separate reservation table
+    allows an existing SqliteHuey database to be opened without rewriting it.
+    Use only leased consumers on a queue configured for leased delivery.
+    """
+    ddl = SqliteStorage.ddl + [
+        'create table if not exists huey_lease ('
+        'queue text not null, task_id integer not null, token text not null, '
+        'expires_at real not null, primary key (queue, task_id), '
+        'unique (queue, token))',
+        'create index if not exists huey_lease_expiry '
+        'on huey_lease (queue, expires_at)']
+    begin_sql = 'begin immediate'
+
+    def __init__(self, name='huey', lease_seconds=60, clock=None,
+                 create_tables=True, **kwargs):
+        self.lease_seconds = self._finite(lease_seconds)
+        if self.lease_seconds <= 0:
+            raise ValueError('lease_seconds must be positive')
+        self.clock = time.time if clock is None else clock
+        if not callable(self.clock):
+            raise ValueError('clock must be callable')
+        super(LeasedSqliteStorage, self).__init__(
+            name, create_tables=False, **kwargs)
+        self.lock = threading.RLock()
+        self._pid = os.getpid()
+        self._savepoint_ids = itertools.count()
+        if create_tables:
+            self.initialize_schema()
+
+    @staticmethod
+    def _finite(value):
+        if isinstance(value, bool):
+            raise ValueError('expected a finite number')
+        try:
+            value = float(value)
+        except (TypeError, ValueError, OverflowError):
+            raise ValueError('expected a finite number')
+        if not math.isfinite(value):
+            raise ValueError('expected a finite number')
+        return value
+
+    def _now(self, now=None):
+        return self._finite(self.clock() if now is None else now)
+
+    def _check_process(self):
+        if os.getpid() != self._pid:
+            # A fork must not reuse the parent's SQLite connection or lock.
+            if self._conn is not None:
+                self._conn.close()
+            self._conn = None
+            self.lock = threading.RLock()
+            self._pid = os.getpid()
+
+    @contextlib.contextmanager
+    def db(self, commit=False, close=False):
+        self._check_process()
+        with self.lock:
+            conn = self.conn
+            cursor = conn.cursor()
+            savepoint = None
+            try:
+                if commit:
+                    if conn.in_transaction:
+                        savepoint = 'huey_sp_%s' % next(self._savepoint_ids)
+                        cursor.execute('savepoint ' + savepoint)
+                    else:
+                        cursor.execute(self.begin_sql)
+                try:
+                    yield cursor
+                except BaseException:
+                    if commit:
+                        if savepoint:
+                            cursor.execute('rollback to ' + savepoint)
+                            cursor.execute('release ' + savepoint)
+                        else:
+                            conn.rollback()
+                    raise
+                else:
+                    if commit:
+                        if savepoint:
+                            cursor.execute('release ' + savepoint)
+                        else:
+                            conn.commit()
+            finally:
+                cursor.close()
+                if close:
+                    conn.close()
+                    self._conn = None
+
+    def reserve(self, now=None):
+        now = self._now(now)
+        with self.db(commit=True) as cursor:
+            cursor.execute(
+                'select t.id, t.data from task t left join huey_lease l '
+                'on l.queue=t.queue and l.task_id=t.id '
+                'where t.queue=? and (l.token is null or l.expires_at<=?) '
+                'order by t.priority desc, t.id limit 1', (self.name, now))
+            row = cursor.fetchone()
+            if row is None:
+                return
+            task_id, data = row
+            token = uuid.uuid4().hex
+            expires_at = now + self.lease_seconds
+            cursor.execute('insert or replace into huey_lease '
+                           '(queue, task_id, token, expires_at) values (?,?,?,?)',
+                           (self.name, task_id, token, expires_at))
+            return Reservation(token, data, expires_at)
+
+    def _owned(self, cursor, token, now):
+        cursor.execute('select task_id from huey_lease where queue=? and '
+                       'token=? and expires_at>?', (self.name, token, now))
+        row = cursor.fetchone()
+        return None if row is None else row[0]
+
+    def owns(self, token, now=None):
+        with self.db() as cursor:
+            return self._owned(cursor, token, self._now(now)) is not None
+
+    def ack(self, token, now=None):
+        with self.db(commit=True) as cursor:
+            task_id = self._owned(cursor, token, self._now(now))
+            if task_id is None:
+                return False
+            cursor.execute('delete from task where queue=? and id=?',
+                           (self.name, task_id))
+            cursor.execute('delete from huey_lease where queue=? and token=?',
+                           (self.name, token))
+            return True
+
+    def renew(self, token, now=None):
+        now = self._now(now)
+        with self.db(commit=True) as cursor:
+            if self._owned(cursor, token, now) is None:
+                return False
+            cursor.execute('update huey_lease set expires_at=max(expires_at,?) '
+                           'where queue=? and token=?',
+                           (now + self.lease_seconds, self.name, token))
+            return True
+
+    def release(self, token, now=None):
+        with self.db(commit=True) as cursor:
+            if self._owned(cursor, token, self._now(now)) is None:
+                return False
+            cursor.execute('delete from huey_lease where queue=? and token=?',
+                           (self.name, token))
+            return True
+
+    @contextlib.contextmanager
+    def complete(self, token):
+        # Only the outcome, never the user task body, runs in this transaction.
+        # Inherited storage operations nest using savepoints, so callback/
+        # result/retry writes and the ack commit or roll back together.
+        with self.db(commit=True) as cursor:
+            if self._owned(cursor, token, self._now()) is None:
+                raise LeaseLost('reservation no longer owned')
+            yield
+            if not self.ack(token):
+                raise LeaseLost('reservation expired during completion')
+
+    def queue_size(self, now=None):
+        return self.sql(
+            'select count(*) from task t left join huey_lease l '
+            'on l.queue=t.queue and l.task_id=t.id where t.queue=? and '
+            '(l.token is null or l.expires_at<=?)',
+            (self.name, self._now(now)), results=True)[0][0]
+
+    def inflight_count(self, now=None):
+        return self.sql('select count(*) from huey_lease '
+                        'where queue=? and expires_at>?',
+                        (self.name, self._now(now)), results=True)[0][0]
+
+    def enqueued_items(self, limit=None):
+        sql = ('select t.data from task t left join huey_lease l '
+               'on l.queue=t.queue and l.task_id=t.id where t.queue=? and '
+               '(l.token is null or l.expires_at<=?) '
+               'order by t.priority desc, t.id')
+        params = [self.name, self._now()]
+        if limit is not None:
+            sql += ' limit ?'
+            params.append(limit)
+        return [row[0] for row in self.sql(sql, params, results=True)]
+
+    def flush_queue(self):
+        with self.db(commit=True):
+            super(LeasedSqliteStorage, self).flush_queue()
+            self.sql('delete from huey_lease where queue=?', (self.name,))
+
+    def dequeue(self):
+        raise ConfigurationError('use reserve/ack for leased storage')
+
+
 class CySqliteStorage(SqliteStorage):
     def __init__(self, name='huey', filename='huey.db', pragmas=None,
                  timeout=5, strict_fifo=False, create_tables=True, **kwargs):
