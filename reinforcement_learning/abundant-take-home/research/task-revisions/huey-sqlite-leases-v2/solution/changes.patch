+class LeasedSqliteHuey(SqliteHuey):
+    """Opt-in at-least-once delivery for SQLite thread/process consumers."""
+    storage_class = LeasedSqliteStorage
+
+    def dequeue(self, now=None):
+        if not isinstance(self.storage, LeasedSqliteStorage):
+            return super(LeasedSqliteHuey, self).dequeue()
+        reservation = self.storage.reserve(now)
+        if reservation is None:
+            return
+        try:
+            task = self.deserialize_task(reservation.data)
+        except Exception:
+            # Match the existing invalid-message policy: discard and report.
+            self.storage.ack(reservation.token, now=now)
+            raise
+        task._lease_token = reservation.token
+        task._lease_storage = self.storage
+        return task
+
+    def execute(self, task, timestamp=None):
+        if task.lease_token and not task._lease_storage.owns(task.lease_token):
+            raise LeaseLost('reservation no longer owned')
+        return super(LeasedSqliteHuey, self).execute(task, timestamp)
+
+    def _task_transition(self, task):
+        if task.lease_token:
+            return task._lease_storage.complete(task.lease_token)
+        return super(LeasedSqliteHuey, self)._task_transition(task)
+
+    def enqueue_due(self, timestamp=None):
+        if not isinstance(self.storage, LeasedSqliteStorage):
+            return super(LeasedSqliteHuey, self).enqueue_due(timestamp)
+        # Schedule removal and every initial queue insertion commit together.
+        # Preserve per-message deserialization handling from read_schedule().
+        with self.storage.db(commit=True):
+            for task in self.read_schedule(timestamp):
+                self.enqueue(task)
+
+
