      "html_url": "https://github.com/Wumpf",
      "followers_url": "https://api.github.com/users/Wumpf/followers",
      "following_url": "https://api.github.com/users/Wumpf/following{/other_user}",
      "gists_url": "https://api.github.com/users/Wumpf/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/Wumpf/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/Wumpf/subscriptions",
      "organizations_url": "https://api.github.com/users/Wumpf/orgs",
      "repos_url": "https://api.github.com/users/Wumpf/repos",
      "events_url": "https://api.github.com/users/Wumpf/events{/privacy}",
