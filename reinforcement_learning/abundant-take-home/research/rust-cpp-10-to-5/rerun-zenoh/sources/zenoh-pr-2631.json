  "title": "feat(routing): upstream (northbound) declaration aggregation",
  "user": {
    "login": "BOURBONCASK",
    "id": 149764027,
    "node_id": "U_kgDOCO03uw",
    "avatar_url": "https://avatars.githubusercontent.com/u/149764027?v=4",
