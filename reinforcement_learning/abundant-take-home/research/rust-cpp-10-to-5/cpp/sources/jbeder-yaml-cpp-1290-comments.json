[{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2186911728","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-2186911728","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":2186911728,"node_id":"IC_kwDOAfkRIM6CWZ_w","user":{"login":"Anton3","id":2719663,"node_id":"MDQ6VXNlcjI3MTk2NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2719663?v=4","gravatar_id":"","url":"https://api.github.com/users/Anton3","html_url":"https://github.com/Anton3","followers_url":"https://api.github.com/users/Anton3/followers","following_url":"https://api.github.com/users/Anton3/following{/other_user}","gists_url":"https://api.github.com/users/Anton3/gists{/gist_id}","starred_url":"https://api.github.com/users/Anton3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Anton3/subscriptions","organizations_url":"https://api.github.com/users/Anton3/orgs","repos_url":"https://api.github.com/users/Anton3/repos","events_url":"https://api.github.com/users/Anton3/events{/privacy}","received_events_url":"https://api.github.com/users/Anton3/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-24T16:01:08Z","updated_at":"2024-06-24T16:04:17Z","body":"This might be okay if the new behavior is more consistent.\r\nNull-like strings should be escaped as `''` and `'null'` anyway.\r\nJust notice that some breaking changes have happened around handling nulls.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2186911728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2186981805","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-2186981805","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":2186981805,"node_id":"IC_kwDOAfkRIM6CWrGt","user":{"login":"jbeder","id":1059334,"node_id":"MDQ6VXNlcjEwNTkzMzQ=","avatar_url":"https://avatars.githubusercontent.com/u/1059334?v=4","gravatar_id":"","url":"https://api.github.com/users/jbeder","html_url":"https://github.com/jbeder","followers_url":"https://api.github.com/users/jbeder/followers","following_url":"https://api.github.com/users/jbeder/following{/other_user}","gists_url":"https://api.github.com/users/jbeder/gists{/gist_id}","starred_url":"https://api.github.com/users/jbeder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jbeder/subscriptions","organizations_url":"https://api.github.com/users/jbeder/orgs","repos_url":"https://api.github.com/users/jbeder/repos","events_url":"https://api.github.com/users/jbeder/events{/privacy}","received_events_url":"https://api.github.com/users/jbeder/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-24T16:37:49Z","updated_at":"2024-06-24T16:37:49Z","body":"You can check the type of the node. Is that sufficient?","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2186981805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2187307256","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-2187307256","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":2187307256,"node_id":"IC_kwDOAfkRIM6CX6j4","user":{"login":"Anton3","id":2719663,"node_id":"MDQ6VXNlcjI3MTk2NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2719663?v=4","gravatar_id":"","url":"https://api.github.com/users/Anton3","html_url":"https://github.com/Anton3","followers_url":"https://api.github.com/users/Anton3/followers","following_url":"https://api.github.com/users/Anton3/following{/other_user}","gists_url":"https://api.github.com/users/Anton3/gists{/gist_id}","starred_url":"https://api.github.com/users/Anton3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Anton3/subscriptions","organizations_url":"https://api.github.com/users/Anton3/orgs","repos_url":"https://api.github.com/users/Anton3/repos","events_url":"https://api.github.com/users/Anton3/events{/privacy}","received_events_url":"https://api.github.com/users/Anton3/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-24T20:01:02Z","updated_at":"2024-06-24T20:01:02Z","body":"Not really, because earlier I force-interpreted the node as a string. I guess that's not possible in the recent versions of the library.\r\n\r\nThe way forward for me will be to go through my configs, replacing `<empty>` with `''` and `null` with `'null'`.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2187307256/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2189297380","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-2189297380","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":2189297380,"node_id":"IC_kwDOAfkRIM6Cfgbk","user":{"login":"Anton3","id":2719663,"node_id":"MDQ6VXNlcjI3MTk2NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2719663?v=4","gravatar_id":"","url":"https://api.github.com/users/Anton3","html_url":"https://github.com/Anton3","followers_url":"https://api.github.com/users/Anton3/followers","following_url":"https://api.github.com/users/Anton3/following{/other_user}","gists_url":"https://api.github.com/users/Anton3/gists{/gist_id}","starred_url":"https://api.github.com/users/Anton3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Anton3/subscriptions","organizations_url":"https://api.github.com/users/Anton3/orgs","repos_url":"https://api.github.com/users/Anton3/repos","events_url":"https://api.github.com/users/Anton3/events{/privacy}","received_events_url":"https://api.github.com/users/Anton3/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-25T15:41:13Z","updated_at":"2024-06-25T15:42:52Z","body":"Reopening because of inconsistency.\r\n\r\nAccording to #590, it seems that a user may want to get the value of a Scalar (in the meaning from the [spec](https://yaml.org/spec/1.2.2/#scalar)), ignoring nulls, and that the library supports it.\r\n\r\nBut what happens in practice is, if the Scalar is a null, then yaml-cpp replaces its value (which can be `<empty> | null | Null | NULL | ~`) with `\"null\"`, without any way to get the original value.\r\n\r\nWhat should happen is, the original text representation of the null value should be kept in the `Scalar()` field. Then `as<std::string>()` should retrieve this stored `Scalar()` field.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2189297380/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2189307348","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-2189307348","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":2189307348,"node_id":"IC_kwDOAfkRIM6Cfi3U","user":{"login":"jbeder","id":1059334,"node_id":"MDQ6VXNlcjEwNTkzMzQ=","avatar_url":"https://avatars.githubusercontent.com/u/1059334?v=4","gravatar_id":"","url":"https://api.github.com/users/jbeder","html_url":"https://github.com/jbeder","followers_url":"https://api.github.com/users/jbeder/followers","following_url":"https://api.github.com/users/jbeder/following{/other_user}","gists_url":"https://api.github.com/users/jbeder/gists{/gist_id}","starred_url":"https://api.github.com/users/jbeder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jbeder/subscriptions","organizations_url":"https://api.github.com/users/jbeder/orgs","repos_url":"https://api.github.com/users/jbeder/repos","events_url":"https://api.github.com/users/jbeder/events{/privacy}","received_events_url":"https://api.github.com/users/jbeder/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-25T15:46:05Z","updated_at":"2024-06-25T15:46:05Z","body":"Yeah that's reasonable. ","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/2189307348/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/4551037871","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-4551037871","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":4551037871,"node_id":"IC_kwDOAfkRIM8AAAABD0NTrw","user":{"login":"sxrzh","id":124703704,"node_id":"U_kgDOB27T2A","avatar_url":"https://avatars.githubusercontent.com/u/124703704?v=4","gravatar_id":"","url":"https://api.github.com/users/sxrzh","html_url":"https://github.com/sxrzh","followers_url":"https://api.github.com/users/sxrzh/followers","following_url":"https://api.github.com/users/sxrzh/following{/other_user}","gists_url":"https://api.github.com/users/sxrzh/gists{/gist_id}","starred_url":"https://api.github.com/users/sxrzh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sxrzh/subscriptions","organizations_url":"https://api.github.com/users/sxrzh/orgs","repos_url":"https://api.github.com/users/sxrzh/repos","events_url":"https://api.github.com/users/sxrzh/events{/privacy}","received_events_url":"https://api.github.com/users/sxrzh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-27T03:46:41Z","updated_at":"2026-05-27T03:46:41Z","body":"It seems that now all the Scalar is always replaced with \"\"(empty string) instead of \"null\". \n\nSee below:\n```\n$ cat 1290.yaml\nthisIsEmpty:\nthisIsnull: null\nthisIsNull: Null\nthisIsNULL: NULL\nthisIsStr: \"null\"\n$ cat 1290.cpp\n#include <iostream>\n#include <cstdio>\n#include <string>\n#include <yaml-cpp/yaml.h>\n\nint main() {\n    std::string input;\n    char c;\n    while((c = getchar()) != EOF) input += c;\n\n    YAML::Node node = YAML::Load(input);\n    for(auto it = node.begin(); it != node.end(); ++it) {\n        std::cout << it->first << \": \" << it->second.as<std::string>()\n                  << \", Scalar: \\\"\" << it->second.Scalar() << \"\\\"\" << '\\n';\n    }\n    return 0;\n}\n$ g++ 1290.cpp -o1290 -lyaml-cpp && ./1290 < 1290.yaml\nthisIsEmpty: null, Scalar: \"\"\nthisIsnull: null, Scalar: \"\"\nthisIsNull: null, Scalar: \"\"\nthisIsNULL: null, Scalar: \"\"\nthisIsStr: null, Scalar: \"null\"\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/4551037871/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/4938176746","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-4938176746","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":4938176746,"node_id":"IC_kwDOAfkRIM8AAAABJlaY6g","user":{"login":"mvanhorn","id":455140,"node_id":"MDQ6VXNlcjQ1NTE0MA==","avatar_url":"https://avatars.githubusercontent.com/u/455140?v=4","gravatar_id":"","url":"https://api.github.com/users/mvanhorn","html_url":"https://github.com/mvanhorn","followers_url":"https://api.github.com/users/mvanhorn/followers","following_url":"https://api.github.com/users/mvanhorn/following{/other_user}","gists_url":"https://api.github.com/users/mvanhorn/gists{/gist_id}","starred_url":"https://api.github.com/users/mvanhorn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mvanhorn/subscriptions","organizations_url":"https://api.github.com/users/mvanhorn/orgs","repos_url":"https://api.github.com/users/mvanhorn/repos","events_url":"https://api.github.com/users/mvanhorn/events{/privacy}","received_events_url":"https://api.github.com/users/mvanhorn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-10T18:06:34Z","updated_at":"2026-07-10T18:06:34Z","body":"Implemented in https://github.com/jbeder/yaml-cpp/pull/1460.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/4938176746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/4962217213","html_url":"https://github.com/jbeder/yaml-cpp/issues/1290#issuecomment-4962217213","issue_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1290","id":4962217213,"node_id":"IC_kwDOAfkRIM8AAAABJ8Vs_Q","user":{"login":"SGSSGene","id":456045,"node_id":"MDQ6VXNlcjQ1NjA0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/456045?v=4","gravatar_id":"","url":"https://api.github.com/users/SGSSGene","html_url":"https://github.com/SGSSGene","followers_url":"https://api.github.com/users/SGSSGene/followers","following_url":"https://api.github.com/users/SGSSGene/following{/other_user}","gists_url":"https://api.github.com/users/SGSSGene/gists{/gist_id}","starred_url":"https://api.github.com/users/SGSSGene/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SGSSGene/subscriptions","organizations_url":"https://api.github.com/users/SGSSGene/orgs","repos_url":"https://api.github.com/users/SGSSGene/repos","events_url":"https://api.github.com/users/SGSSGene/events{/privacy}","received_events_url":"https://api.github.com/users/SGSSGene/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-13T20:08:33Z","updated_at":"2026-07-13T20:08:33Z","body":"I think there is a fundamental error in yaml-cpp. Instead of having three types Scalar, Sequence and Map it has a third type called Null (Technically, yaml-cpp also knows the type Undefined).\nBut Null should be a Scalar type, similar to how booleans or integers are Scalar types ([Yaml Specs](https://yaml.org/spec/1.2.2/#10211-null))\n\nProperly fixing this breaks a lot of API.\n","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments/4962217213/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]