sers/gabime/followers","following_url":"https://api.github.com/users/gabime/following{/other_user}","gists_url":"https://api.github.com/users/gabime/gists{/gist_id}","starred_url":"https://api.github.com/users/gabime/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gabime/subscriptions","organizations_url":"https://api.github.com/users/gabime/orgs","repos_url":"https://api.github.com/users/gabime/repos","events_url":"https://api.github.com/users/gabime/events{/privacy}","received_events_url":"https://api.github.com/users/gabime/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-11-25T10:40:44Z","updated_at":"2022-11-25T10:42:00Z","body":" I think the cleaning [function](https://github.com/gabime/spdlog/blob/50e8b2d982e40266f61b9a0d023c008322c650cb/include/spdlog/sinks/daily_file_sink.h#L228) could be fixed to stop relying on the `filenames_q_` and search for old files to delete instead. \r\nIf this fixed, the entire filenames_q_ mechanism can be removed, which would  simplify the code  significantly.\r\n\r\nPR is welcome.","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1327311323/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1327315487","html_url":"https://github.com/gabime/spdlog/issues/2553#issuecomment-1327315487","issue_url":"https://api.github.com/repos/gabime/spdlog/issues/2553","id":1327315487,"node_id":"IC_kwDOAY1ReM5PHTof","user":{"login":"daniele77","id":5451767,"node_id":"MDQ6VXNlcjU0NTE3Njc=","avatar_url":"https://avatars.githubusercontent.com/u/5451767?v=4","gravatar_id":"","url":"https://api.github.com/users/daniele77","html_url":"https://github.com/daniele77","followers_url":"https://api.github.com/users/daniele77/followers","following_url":"https://api.github.com/users/daniele77/following{/other_user}","gists_url":"https://api.github.com/users/daniele77/gists{/gist_id}","starred_url":"https://api.github.com/users/daniele77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daniele77/subscriptions","organizations_url":"https://api.github.com/users/daniele77/orgs","repos_url":"https://api.github.com/users/daniele77/repos","events_url":"https://api.github.com/users/daniele77/events{/privacy}","received_events_url":"https://api.github.com/users/daniele77/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-11-25T10:45:28Z","updated_at":"2022-11-25T10:45:28Z","body":"I agree.\r\nI'm pretty busy right now, so I'm not sure I'll be able to submit a PR anytime soon.\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1327315487/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1386490788","html_url":"https://github.com/gabime/spdlog/issues/2553#issuecomment-1386490788","issue_url":"https://api.github.com/repos/gabime/spdlog/issues/2553","id":1386490788,"node_id":"IC_kwDOAY1ReM5SpCuk","user":{"login":"andy-byers","id":84697299,"node_id":"MDQ6VXNlcjg0Njk3Mjk5","avatar_url":"https://avatars.githubusercontent.com/u/84697299?v=4","gravatar_id":"","url":"https://api.github.com/users/andy-byers","html_url":"https://github.com/andy-byers","followers_url":"https://api.github.com/users/andy-byers/followers","following_url":"https://api.github.com/users/andy-byers/following{/other_user}","gists_url":"https://api.github.com/users/andy-byers/gists{/gist_id}","starred_url":"https://api.github.com/users/andy-byers/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andy-byers/subscriptions","organizations_url":"https://api.github.com/users/andy-byers/orgs","repos_url":"https://api.github.com/users/andy-byers/repos","events_url":"https://api.github.com/users/andy-byers/events{/privacy}","received_events_url":"https://api.github.com/users/andy-byers/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-01-18T05:01:06Z","updated_at":"2023-01-18T05:01:06Z","body":"I was thinking that we can't guarantee that there won't be a ton of files to look through, so what if we just allowed a certain number of missing files in the search, something like: \r\n```C++\r\nint allowed_missing = 32;\r\nwhile (filenames.size() < max_files_)\r\n{\r\n    auto filename = FileNameCalc::calc_filename(base_filename_, now_tm(now));\r\n    if (path_exists(filename))\r\n    {\r\n        filenames.emplace_back(filename);\r\n    } else if (--allowed_missing <= 0)\r\n    {\r\n        break;\r\n    }\r\n    now -= std::chrono::hours(24);\r\n}\r\n```\r\n\r\nI know it' not very robust, but is that a sensible compromise? Otherwise, I'd be willing to implement searching for files to remove. It seems like we could repurpose code from `count_files()` to do this.\r\n\r\n\r\n\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1386490788/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1397231568","html_url":"https://github.com/gabime/spdlog/issues/2553#issuecomment-1397231568","issue_url":"https://api.github.com/repos/gabime/spdlog/issues/2553","id":1397231568,"node_id":"IC_kwDOAY1ReM5TSA_Q","user":{"login":"daniele77","id":5451767,"node_id":"MDQ6VXNlcjU0NTE3Njc=","avatar_url":"https://avatars.githubusercontent.com/u/5451767?v=4","gravatar_id":"","url":"https://api.github.com/users/daniele77","html_url":"https://github.com/daniele77","followers_url":"https://api.github.com/users/daniele77/followers","following_url":"https://api.github.com/users/daniele77/following{/other_user}","gists_url":"https://api.github.com/users/daniele77/gists{/gist_id}","starred_url":"https://api.github.com/users/daniele77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daniele77/subscriptions","organizations_url":"https://api.github.com/users/daniele77/orgs","repos_url":"https://api.github.com/users/daniele77/repos","events_url":"https://api.github.com/users/daniele77/events{/privacy}","received_events_url":"https://api.github.com/users/daniele77/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-01-19T16:14:29Z","updated_at":"2023-01-19T16:14:29Z","body":"@andy-byers this could be a partial solution, but you should have the const `allowed_missing` big enough to take into account the case when one starts the application a few months after the last run (e.g., an embedded system that you use just once in a while).\r\n\r\nTo manage the general case, you would end up with an `allowed_missing` so big that every time the algorithm must check hundreds of paths before stopping. And this would happen when there is no gap in the log files, as well.\r\n\r\nSo, what's the worse between:\r\n\r\n- checking the name of all the files in the directory (being sure that the algorithm never fails) OR \r\n- checking the presence of hundreds of file names (with the possibility that there are files older than the allowed_missing value we choose)?\r\n\r\nI've no doubt the best solution is to check all the files in the directory for log files name.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1397231568/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1397349175","html_url":"https://github.com/gabime/spdlog/issues/2553#issuecomment-1397349175","issue_url":"https://api.github.com/repos/gabime/spdlog/issues/2553","id":1397349175,"node_id":"IC_kwDOAY1ReM5TSds3","user":{"login":"gabime","id":6052198,"node_id":"MDQ6VXNlcjYwNTIxOTg=","avatar_url":"https://avatars.githubusercontent.com/u/6052198?v=4","gravatar_id":"","url":"https://api.github.com/users/gabime","html_url":"https://github.com/gabime","followers_url":"https://api.github.com/users/gabime/followers","following_url":"https://api.github.com/users/gabime/following{/other_user}","gists_url":"https://api.github.com/users/gabime/gists{/gist_id}","starred_url":"https://api.github.com/users/gabime/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gabime/subscriptions","organizations_url":"https://api.github.com/users/gabime/orgs","repos_url":"https://api.github.com/users/gabime/repos","events_url":"https://api.github.com/users/gabime/events{/privacy}","received_events_url":"https://api.github.com/users/gabime/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-01-19T17:29:06Z","updated_at":"2023-01-19T17:29:06Z","body":"> I've no doubt the best solution is to check all the files in the directory for log files name.\r\n\r\nI second that. ","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1397349175/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/gabime/spdlog/issues/comments/1397556462","html_url":"https://github.com/gabime/spdlog/issues/2553#issuecomment-1397556462","issue_url":"https://api.github.com/repos/gabime/spdlog/issues/2553","id":1397556462,"node_id":"IC_kwDOAY1ReM5TTQTu","user":{"login":"andy-byers","id":84697299,"node_id":"MDQ6VXNlcjg0Njk