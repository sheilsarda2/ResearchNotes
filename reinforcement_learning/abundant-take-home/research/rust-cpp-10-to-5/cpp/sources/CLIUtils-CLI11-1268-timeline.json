1/labels{/name}","releases_url":"https://api.github.com/repos/CLIUtils/CLI11/releases{/id}","deployments_url":"https://api.github.com/repos/CLIUtils/CLI11/deployments","created_at":"2017-01-25T22:29:34Z","updated_at":"2026-09-12T13:57:13Z","pushed_at":"2026-09-07T21:40:47Z","git_url":"git://github.com/CLIUtils/CLI11.git","ssh_url":"git@github.com:CLIUtils/CLI11.git","clone_url":"https://github.com/CLIUtils/CLI11.git","svn_url":"https://github.com/CLIUtils/CLI11","homepage":"https://cliutils.github.io/CLI11/","size":5674,"stargazers_count":4441,"watchers_count":4441,"language":"C++","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":false,"has_pages":true,"has_discussions":true,"forks_count":469,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":80,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["cli","cli-parser","cpp11","no-dependencies"],"visibility":"public","forks":469,"open_issues":80,"watchers":4441,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Submitting another issue for #1268, because I can't reopen it. I believe the issue was not solved.\nA help for a subcommand subc2 is not shown if subc1 has a positional option and is not provided for the help message.\n\nBelow is the minimum reproducible example.\nAs you can see, .calling `/cli11_help_bug subc1 subc2 --help` provides help on subc1, not subc2.\n\n```shell\n$> ./cli11_help_bug subc1 --help\nFirst subcommand\n\n\n./cli11_help_bug subc1 [OPTIONS] ID [SUBCOMMAND]\n\n\nPOSITIONALS:\n  ID INT REQUIRED             Object ID\n\nOPTIONS:\n  -h,     --help              Print this help message and exit\n\nSUBCOMMANDS:\n  subc2                       Nested subcommand\n$> ./cli11_help_bug subc1 subc2 --help\nFirst subcommand\n\n\n./cli11_help_bug subc1 [OPTIONS] ID [SUBCOMMAND]\n\n\nPOSITIONALS:\n  ID INT REQUIRED             Object ID\n\nOPTIONS:\n  -h,     --help              Print this help message and exit\n\nSUBCOMMANDS:\n  subc2                       Nested subcommand\n```\n\n### Reproduction example\n\n```c++\n#include <CLI/CLI.hpp>\n\nint main(int argc, char** argv) {\n    CLI::App app{\"CLI11 help bug MRE\"};\n\n    auto* subc1 = app.add_subcommand(\"subc1\", \"First subcommand\");\n\n    int id{};\n    subc1->add_option(\"ID\", id, \"Object ID\")->required();\n\n    auto* subc2 = subc1->add_subcommand(\"subc2\", \"Nested subcommand\");\n\n    bool flag{false};\n    subc2->add_flag(\"--flag\", flag, \"Example flag\");\n\n    CLI11_PARSE(app, argc, argv);\n\n    return 0;\n}\n```\n\nAdding positional argument:\n```\n$ ./cli11_help_bug subc1 1 subc2 --help\nNested subcommand\n\n\n./cli11_help_bug subc1 subc2 [OPTIONS]\n\n\nOPTIONS:\n  -h,     --help              Print this help message and exit\n          --flag              Example flag\n```","reactions":{"url":"https://api.github.com/repos/CLIUtils/CLI11/issues/1450/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/CLIUtils/CLI11/issues/1450/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"}]