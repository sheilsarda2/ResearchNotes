[{"id":16435049185,"node_id":"RTE_lADOANpJv86rZ0JczwAAAAPTmvLh","url":"https://api.github.com/repos/ericniebler/range-v3/issues/events/16435049185","actor":{"login":"tobiasludwig-tomtom","id":86796418,"node_id":"MDQ6VXNlcjg2Nzk2NDE4","avatar_url":"https://avatars.githubusercontent.com/u/86796418?v=4","gravatar_id":"","url":"https://api.github.com/users/tobiasludwig-tomtom","html_url":"https://github.com/tobiasludwig-tomtom","followers_url":"https://api.github.com/users/tobiasludwig-tomtom/followers","following_url":"https://api.github.com/users/tobiasludwig-tomtom/following{/other_user}","gists_url":"https://api.github.com/users/tobiasludwig-tomtom/gists{/gist_id}","starred_url":"https://api.github.com/users/tobiasludwig-tomtom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tobiasludwig-tomtom/subscriptions","organizations_url":"https://api.github.com/users/tobiasludwig-tomtom/orgs","repos_url":"https://api.github.com/users/tobiasludwig-tomtom/repos","events_url":"https://api.github.com/users/tobiasludwig-tomtom/events{/privacy}","received_events_url":"https://api.github.com/users/tobiasludwig-tomtom/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2025-02-24T17:19:37Z","rename":{"from":"ranges::stable_sort alters input values","to":"ranges::stable_sort destroys input values"},"performed_via_github_app":null},{"id":16435087410,"node_id":"SE_lADOANpJv86rZ0JczwAAAAPTm4gy","url":"https://api.github.com/repos/ericniebler/range-v3/issues/events/16435087410","actor":{"login":"AlekseiMarkelov-TomTom","id":129756239,"node_id":"U_kgDOB7vsTw","avatar_url":"https://avatars.githubusercontent.com/u/129756239?v=4","gravatar_id":"","url":"https://api.github.com/users/AlekseiMarkelov-TomTom","html_url":"https://github.com/AlekseiMarkelov-TomTom","followers_url":"https://api.github.com/users/AlekseiMarkelov-TomTom/followers","following_url":"https://api.github.co