ubscribers_url":"https://api.github.com/repos/jbeder/yaml-cpp/subscribers","subscription_url":"https://api.github.com/repos/jbeder/yaml-cpp/subscription","commits_url":"https://api.github.com/repos/jbeder/yaml-cpp/commits{/sha}","git_commits_url":"https://api.github.com/repos/jbeder/yaml-cpp/git/commits{/sha}","comments_url":"https://api.github.com/repos/jbeder/yaml-cpp/comments{/number}","issue_comment_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/comments{/number}","contents_url":"https://api.github.com/repos/jbeder/yaml-cpp/contents/{+path}","compare_url":"https://api.github.com/repos/jbeder/yaml-cpp/compare/{base}...{head}","merges_url":"https://api.github.com/repos/jbeder/yaml-cpp/merges","archive_url":"https://api.github.com/repos/jbeder/yaml-cpp/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/jbeder/yaml-cpp/downloads","issues_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues{/number}","pulls_url":"https://api.github.com/repos/jbeder/yaml-cpp/pulls{/number}","milestones_url":"https://api.github.com/repos/jbeder/yaml-cpp/milestones{/number}","notifications_url":"https://api.github.com/repos/jbeder/yaml-cpp/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jbeder/yaml-cpp/labels{/name}","releases_url":"https://api.github.com/repos/jbeder/yaml-cpp/releases{/id}","deployments_url":"https://api.github.com/repos/jbeder/yaml-cpp/deployments","created_at":"2015-03-30T02:52:32Z","updated_at":"2026-09-12T10:06:50Z","pushed_at":"2026-09-08T07:19:10Z","git_url":"git://github.com/jbeder/yaml-cpp.git","ssh_url":"git@github.com:jbeder/yaml-cpp.git","clone_url":"https://github.com/jbeder/yaml-cpp.git","svn_url":"https://github.com/jbeder/yaml-cpp","homepage":"","size":5795,"stargazers_count":6133,"watchers_count":6133,"language":"C++","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":2192,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":185,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":2192,"open_issues":185,"watchers":6133,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Hi,\n\nI am using yaml-cpp for parsing/emitting YAML because it is very simple and flexible as it comes with many predefined type conversions which can easily be extended.\nHowever, the behaviour of the underlying shared memory management is surprising to say the least: in a simple example as the following, the memory usage will increase out of bounds (several GBytes before the program gets killed).\n\nYAML::Node node;  \nnode[\"test\"] = 42;  \nfor(auto i=0; i<10000000; ++i) {  \n    node[\"test\"] = 42;  \n}\n\nThere is a live repro here: https://godbolt.org/z/4PWezz16r. I first issued an open question on stackoverflow here: https://stackoverflow.com/staging-ground/79939206\n\nWhile the example is rather artificial, we have cases where we read and override configuration data (YAML) many times, and having such behaviour as described above makes us hesitate to use yaml-cpp.\n\nThanks for any hints on this. Cheers,\nRalf","reactions":{"url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1436/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/jbeder/yaml-cpp/issues/1436/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"}]