.com/repos/zeux/pugixml/issues/437","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/437/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/437/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/437/events","html_url":"https://github.com/zeux/pugixml/issues/437","id":976818585,"node_id":"MDU6SXNzdWU5NzY4MTg1ODU=","number":437,"title":"Memory Allocation Function per Document","user":{"login":"J-Richter","id":4537871,"node_id":"MDQ6VXNlcjQ1Mzc4NzE=","avatar_url":"https://avatars.githubusercontent.com/u/4537871?v=4","gravatar_id":"","url":"https://api.github.com/users/J-Richter","html_url":"https://github.com/J-Richter","followers_url":"https://api.github.com/users/J-Richter/followers","following_url":"https://api.github.com/users/J-Richter/following{/other_user}","gists_url":"https://api.github.com/users/J-Richter/gists{/gist_id}","starred_url":"https://api.github.com/users/J-Richter/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/J-Richter/subscriptions","organizations_url":"https://api.github.com/users/J-Richter/orgs","repos_url":"https://api.github.com/users/J-Richter/repos","events_url":"https://api.github.com/users/J-Richter/events{/privacy}","received_events_url":"https://api.github.com/users/J-Richter/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8614708,"node_id":"MDU6TGFiZWw4NjE0NzA4","url":"https://api.github.com/repos/zeux/pugixml/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2021-08-23T09:21:17Z","updated_at":"2025-07-18T19:51:44Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Currently memory allocation functions can only be set globally with set_memory_management_functions.\r\nWe use it to allocate separate mmap regions to a very large xml document. But this does not scale with more than one document. It is not easy to have separate memory allocators per document.\r\nThis is the enhancement request to have document specific memory allocation/deallocation functions.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/437/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/367","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/367/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/367/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/367/events","html_url":"https://github.com/zeux/pugixml/issues/367","id":681682503,"node_id":"MDU6SXNzdWU2ODE2ODI1MDM=","number":367,"title":"Proper XML Namespaces support","user":{"login":"ddevienne","id":219319,"node_id":"MDQ6VXNlcjIxOTMxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/219319?v=4","gravatar_id":"","url":"https://api.github.com/users/ddevienne","html_url":"https://github.com/ddevienne","followers_url":"https://api.github.com/users/ddevienne/followers","following_url":"https://api.github.com/users/ddevienne/following{/other_user}","gists_url":"https://api.github.com/users/ddevienne/gists{/gist_id}","starred_url":"https://api.github.com/users/ddevienne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ddevienne/subscriptions","organizations_url":"https://api.github.com/users/ddevienne/orgs","repos_url":"https://api.github.com/users/ddevienne/repos","events_url":"https://api.github.com/users/ddevienne/events{/privacy}","received_events_url":"https://api.github.com/users/ddevienne/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8614708,"node_id":"MDU6TGFiZWw4NjE0NzA4","url":"https://api.github.com/repos/zeux/pugixml/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2020-08-19T09:17:38Z","updated_at":"2025-07-16T16:52:33Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I've searched issues, and although there are a few related to namespaces, they do not tackle the real issue,\r\nwhich is that all node's namespace **URI** should be available. Knowing a node's namespace-qualified name\r\n(i.e. NS-Prefix _colon_ Local-Name) is insufficient, because of default namespaces, and the fact prefixes are arbitrary\r\nand only namespace URIs matter. Namespaces in XML are pretty essential.\r\n\r\nThe XML parser is best suited to keep track of in-scope namespaces, and assign them to nodes.\r\nClient code would need to scan the whole document for all namespace-related attributes, and for\r\nall element names, maintain a stack of in-scope namespace, and keep an **external** _shadow DOM_\r\n(i.e. a map) to know the NS URI of all nodes, which is possible, but cumbersome **and** inefficient.\r\n\r\n(BTW, I don't see how the `namespace-uri() = X` XPath predicate can be correct and efficient w/o the\r\nparse-tree knowing about the NS of all nodes, as described above)\r\n\r\nI'm currently using https://github.com/svgpp/rapidxml_ns, but would welcome being able to replace it with pugixml,\r\nprovided proper XML Namespaces support. Please consider this a formal request for Enhancement. Thanks, --DD","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/367/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/367/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/656","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/656/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/656/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/656/events","html_url":"https://github.com/zeux/pugixml/issues/656","id":2788757397,"node_id":"I_kwDOAEsfpc6mOQ-V","number":656,"title":"Better informal support for namespaces","user":{"login":"KaruroChori","id":9377545,"node_id":"MDQ6VXNlcjkzNzc1NDU=","avatar_url":"https://avatars.githubusercontent.com/u/9377545?v=4","gravatar_id":"","url":"https://api.github.com/users/KaruroChori","html_url":"https://github.com/KaruroChori","followers_url":"https://api.github.com/users/KaruroChori/followers","following_url":"https://api.github.com/users/KaruroChori/following{/other_user}","gists_url":"https://api.github.com/users/KaruroChori/gists{/gist_id}","starred_url":"https://api.github.com/users/KaruroChori/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KaruroChori/subscriptions","organizations_url":"https://api.github.com/users/KaruroChori/orgs","repos_url":"https://api.github.com/users/KaruroChori/repos","events_url":"https://api.github.com/users/KaruroChori/events{/privacy}","received_events_url":"https://api.github.com/users/KaruroChori/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8614708,"node_id":"MDU6TGFiZWw4NjE0NzA4","url":"https://api.github.com/repos/zeux/pugixml/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-01-15T03:34:04Z","updated_at":"2025-07-06T11:43:29Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"It is clear that pugixml has no support for XML namespaces, but it is still desirable to use them even if in just some kind of lightweight manner.  \r\nOne can simply assume they are specified as prefix of tags and attributes. I am doing just that in several of my projects.   \r\nHowever the current interface for `child(...)` and `attribute(...)` makes the process of working with these informal namespaces quite frustrating and not very ergonomic.  \r\nBasically, one is: \r\n- either forced to build strings to have the `ns:` prefix for each affected name and use those functions with them.  \r\n  This in general requires temporary string objects, which can be quite heavy on memory allocations for no good reason.\r\n- or to manually iterate over each element and perform two smaller string checks, basically replicating the internal functionality of the original functions.  \r\n  This avoids the issue of memory allocations, at the cost of code clarity.\r\n\r\nThis issue could be easily mitigated by providing few more functions (and their string_view overloads) like `ns_child` and `ns_attribute`.\r\nThey would accept an extra first argument, which is informally interpreted as namespace. ","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/656/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/656/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/599","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/599/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/599/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/599/events","html_url":"https://github.com/zeux/pugixml/issues/599","id":2018759513,"node_id":"I_kwDOAEsfpc54U9NZ","number":599,"title":"option to join multiple CDATA sections into one when parsing","user":{"login":"schulzer","id":42833033,"node_id":"MDQ6VXNlcjQyODMzMDMz","avatar_url":"https://avatars.githubusercontent.com/u/42833033?v=4","gravatar_id":"","url":"https://api.github.com/users/schulzer","html_url":"https://github.com/schulzer","followers_url":"https://api.github.com/users/schulzer/followers","following_url":"https://api.github.com/users/schulzer/following{/other_user}","gists_url":"https://api.github.com/users/schulzer/gists{/gist_id}","starred_url":"https://api.github.com/users/schulzer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schulzer/subscriptions","organizations_url":"https://api.github.com/users/schulzer/orgs","repos_url":"https://api.github.com/users/schulzer/repos","events_url":"https://api.github.com/users/schulzer/events{/privacy}","received_events_url":"https://api.github.com/users/schulzer/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8614708,"node_id":"MDU6TGFiZWw4NjE0NzA4","url":"https://api.github.com/repos/zeux/pugixml/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2023-11-30T14:15:20Z","updated_at":"2023-12-18T14:59:53Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":" This is similar to 'Comments split Text into multiple Nodes #546' when considering a complicated document with lots of escaping\r\n```xml\r\n<node> some&amp;data ]]> more&amp;data <node>\r\n```\r\nThis could be rewritten (somewhat simplified) but erroneous\r\n```xml\r\n<node> <![CDATA[some&data ]]> more&data]]> <node>\r\n```\r\nand corrected\r\n```xml\r\n<node> <![CDATA[some&data ]]]><![CDATA[]> more&data]]> <node>\r\n```\r\nIn any case (the original and final) the user would like to call `doc.child(\"node\").child_value()` and access the stored data, without complicated logic to iterate over all children and concatenate their values, in particular as this node could be called 'url' and could be given in various different versions, which require currently various different versions of code to access the full URL, coming back _I as a user_ would like to have an options to retrieve all those flavours nice and cleanly de-escaped with a single access point, because at the end essentially only this _single value_ URL is encoded, from a logical/high level stand point, from low level I see the reason why they are split as they are and stored into multiple child nodes.\r\n\r\nIf this is an acceptable change, I could offer handing in a pull request.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/599/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/599/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/318","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/318/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/318/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/318/events","html_url":"https://github.com/zeux/pugixml/pull/318","id":542676510,"node_id":"MDExOlB1bGxSZXF1ZXN0MzU3MDcyMDUy","number":318,"title":"Implement <xml_memory_pool> interface for custom allocators","user":{"login":"Ambal","id":101150,"node_id":"MDQ6VXNlcjEwMTE1MA==","avatar_url":"https://avatars.githubusercontent.com/u/101150?v=4","gravatar_id":"","url":"https://api.github.com/users/Ambal","html_url":"https://github.com/Ambal","followers_url":"https://api.github.com/users/Ambal/followers","following_url":"https://api.github.com/users/Ambal/following{/other_user}","gists_url":"https://api.github.com/users/Ambal/gists{/gist_id}","starred_url":"https://api.github.com/users/Ambal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ambal/subscriptions","organizations_url":"https://api.github.com/users/Ambal/orgs","repos_url":"https://api.github.com/users/Ambal/repos","events_url":"https://api.github.com/users/Ambal/events{/privacy}","received_events_url":"https://api.github.com/users/Ambal/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2019-12-26T21:39:12Z","updated_at":"2020-01-01T22:35:10Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/zeux/pugixml/pulls/318","html_url":"https://github.com/zeux/pugixml/pull/318","diff_url":"https://github.com/zeux/pugixml/pull/318.diff","patch_url":"https://github.com/zeux/pugixml/pull/318.patch","merged_at":null},"body":"The <xml_memory_pool> interface is a simplified version of the C++17's std::pmr::memory_resource. Allows construction of pugi::xml_document/pugi::xpath_query objects using preallocated memory buffers. Two specific memory pools are provided:\r\n1) xml_monotonic_memory_pool - similar to std::pmr::monotonic_memory_resource;\r\n2) memory_resource_adapter<T> - wrapper for classes which implement interface similar to std::pmr::memory_resource;\r\n\r\nSome limitations:\r\n1) <xml_memory_pool> cannot be used with all xpath-related classes due to binary incompatibility, only <xpath_query> is supported;\r\n2) <xpath_query> swaps memory pools in move assignment operator since functionality to clone internal structures is missing;","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/318/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/318/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/103","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/103/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/103/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/103/events","html_url":"https://github.com/zeux/pugixml/issues/103","id":165900740,"node_id":"MDU6SXNzdWUxNjU5MDA3NDA=","number":103,"title":"Better node visitor interface","user":{"login":"zeux","id":1106629,"node_id":"MDQ6VXNlcjExMDY2Mjk=","avatar_url":"https://avatars.githubusercontent.com/u/1106629?v=4","gravatar_id":"","url":"https://api.github.com/users/zeux","html_url":"https://github.com/zeux","followers_url":"https://api.github.com/users/zeux/followers","following_url":"https://api.github.com/users/zeux/following{/other_user}","gists_url":"https://api.github.com/users/zeux/gists{/gist_id}","starred_url":"https://api.github.com/users/zeux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeux/subscriptions","organizations_url":"https://api.github.com/users/zeux/orgs","repos_url":"https://api.github.com/users/zeux/repos","events_url":"https://api.github.com/users/zeux/events{/privacy}","received_events_url":"https://api.github.com/users/zeux/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8614708,"node_id":"MDU6TGFiZWw4NjE0NzA4","url":"https://api.github.com/repos/zeux/pugixml/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2016-07-16T00:56:40Z","updated_at":"2017-05-14T19:47:58Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Assuming node visitor interface is a good idea (is it? not 100% clear), there are several problems with existing xml_tree_walker:\n1. ::begin/::end are pretty pointless - could be called from external code\n2. No way to get callbacks before/after the subtree - this is what begin/end could have been. This was mentioned (if memory serves) in https://code.google.com/p/pugixml/issues/detail?id=219 but this link is now dead.\n3. No way to skip a subtree. This is mentioned in issue #77.\n\nWhile manually implementing a recursive traversal is pretty trivial, all traversals that pugixml implements are stackless (which is not as simple/concise to write yourself), so there seems to be some value in a generic traversal. There are still several implementation options though:\n1. Interface with virtual functions. This will have to be a new interface to maintain binary compatibility - xml_tree_visitor or something like that.\n2. Pseudo-interface with templated member functions. This can be faster, although in a non-LTO build it's a weird tradeoff - templated implementations can't inline node structure accessors, while an implementation based on virtual dispatch can't inline user code. With LTO or header-only mode the approach based on compile-time polymorphism should be faster though. This can be seen as an extension of xml_node::find_node.\n3. Tree iterator with ability to descend into a subtree or skip it, so that the user code is in control of the flow.\n\nThese need to be evaluated for the performance and versatility in various scenarios. 1 and 2 are extensions of existring ::traverse() support while 3 is basically a separate idea.\n\nFinally, there is - as it is - quite a few ways to traverse the nodes in pugixml. Ideally if we do need a new way it has to supplant the old one - that is, we should at the minimum deprecate existing ::traverse in favor of whatever the new interface is.\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/103/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/103/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/22","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/22/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/22/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/22/events","html_url":"https://github.com/zeux/pugixml/issues/22","id":48664933,"node_id":"MDU6SXNzdWU0ODY2NDkzMw==","number":22,"title":"add std::optional-like return for your attribute-getters","user":{"login":"LowLevelMahn","id":580819,"node_id":"MDQ6VXNlcjU4MDgxOQ==","avatar_url":"ht