repos/zeux/pugixml/issues/15","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/15/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/15/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/15/events","html_url":"https://github.com/zeux/pugixml/issues/15","id":46837493,"node_id":"MDU6SXNzdWU0NjgzNzQ5Mw==","number":15,"title":"Integer/floating point parsing should validate content and/or value range","user":{"login":"zeux","id":1106629,"node_id":"MDQ6VXNlcjExMDY2Mjk=","avatar_url":"https://avatars.githubusercontent.com/u/1106629?v=4","gravatar_id":"","url":"https://api.github.com/users/zeux","html_url":"https://github.com/zeux","followers_url":"https://api.github.com/users/zeux/followers","following_url":"https://api.github.com/users/zeux/following{/other_user}","gists_url":"https://api.github.com/users/zeux/gists{/gist_id}","starred_url":"https://api.github.com/users/zeux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeux/subscriptions","organizations_url":"https://api.github.com/users/zeux/orgs","repos_url":"https://api.github.com/users/zeux/repos","events_url":"https://api.github.com/users/zeux/events{/privacy}","received_events_url":"https://api.github.com/users/zeux/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8614708,"node_id":"MDU6TGFiZWw4NjE0NzA4","url":"https://api.github.com/repos/zeux/pugixml/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2014-10-26T09:01:30Z","updated_at":"2026-05-31T03:40:31Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"This issue was filed on Google Code: https://code.google.com/p/pugixml/issues/detail?id=237\n\nThere are concerns about using errno on some platforms; even on platforms that have MT-safe errno, parsing denormal numbers will set errno to ERANGE but keep the parsed output as far as I know.\n\nChecking the end pointer can potentially be a breaking change if applications relied on parsing numbers like \"1.2f\".\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/15/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/15/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/378","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/378/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/378/comments","events_url":"https://api.github.com/repos/zeux/pugixml/issues/378/events","html_url":"https://github.com/zeux/pugixml/issues/378","id":732181342,"node_id":"MDU6SXNzdWU3MzIxODEzNDI=","number":378,"title":"PugiXML incorrectly handles char8_t in C++20","user":{"login":"ytimenkov","id":7413219,"node_id":"MDQ6VXNlcjc0MTMyMTk=","avatar_url":"https://avatars.githubusercontent.com/u/7413219?v=4","gravatar_id":"","url":"https://api.github.com/users/ytimenkov","html_url":"https://github.com/ytimenkov","followers_url":"https://api.github.com/users/ytimenkov/followers","following_url":"https://api.github.com/users/ytimenkov/following{/other_user}","gists_url":"https://api.github.com/users/ytimenkov/gists{/gist_id}","starred_url":"https://api.github.com/users/ytimenkov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ytimenkov/subscriptions","organizations_url":"https://api.github.com/users/ytimenkov/orgs","repos_url":"https://api.github.com/users/ytimenkov/repos","events_url":"https://api.github.com/users/ytimenkov/events{/privacy}","received_events_url":"https://api.github.com/users/ytimenkov/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2020-10-29T10:13:53Z","updated_at":"2026-05-27T16:21:17Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In C++20 there is a `std::u8string` and `char8_t` to make UTF-8 type-safe.\r\n\r\nUnfortunately when calling `xml_attribute::set_value(u8\"a string\")` for example compiler chooses `set_value(bool)` overload which lead to a surprise when all attrubutes became juse `\"true\"`.\r\n\r\nWhich makes me thing that providing an overload which accepts `bool` is too wide: it can be any pointer at least. Would be nice to constrain it somehow.\r\n\r\nI'm not sure if there is a need to have a separate handling when `pugi::char_t` is `wchar_t` or simply provide such overload when it's a `char`.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/zeux/pugixml/issues/378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zeux/pugixml/issues/378/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/zeux/pugixml/issues/644","repository_url":"https://api.github.com/repos/zeux/pugixml","labels_url":"https://api.github.com/repos/zeux/pugixml/issues/644/labels{/name}","comments_url":"https://api.github.com/repos/zeux/pugixml/issues/644/comments","events_url":"https://api.github.com/rep