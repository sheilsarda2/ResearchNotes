+        let path = Path::from("test");
+
+        // Server returns 5 bytes
+        mock.push(
+            Response::builder()
+                .header(CONTENT_LENGTH, 5)
+                .header(ETAG, "test-etag")
+                .body("hello".to_string())
+                .unwrap(),
+        );
+
+        // Error after Content-Length bytes should not trigger retry
+        let result = client
