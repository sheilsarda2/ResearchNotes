+                .body(Chunked::new(vec![
+                    Ok(Bytes::from_static(b"hello")),
+                    Err(()),
+                ]))
+                .unwrap(),
+        );
+
+        // Server returns 206 but with wrong Content-Range
+        mock.push_fn(|req| {
+            assert_eq!(
