      "title": "Add soft-commit and NRT overlay: IndexWriter::soft_commit, IndexWriter::nrt_searcher, and NrtDirectory",
      "user": {
        "login": "MagellaX",
        "id": 144127816,
        "node_id": "U_kgDOCJc3SA",
