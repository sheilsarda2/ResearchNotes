-                let obj = stack.top()?;
-                let idx = stack.memo_len() as u32;
-                stack.memo_put(idx, obj);
+            None => {
+                text.push(char::from(byte));
+                i += 1;
             }
-            OpCode::Stop => break,
         }
     }
-    stack.pop()
+    Ok(text)
