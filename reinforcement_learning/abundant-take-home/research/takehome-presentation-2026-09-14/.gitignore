!/.build/build-all-tasks-deck.mjs
!/.build/build-all-tasks-deck-revised.mjs
!/.build/build-all-tasks-deck-exec-summary.mjs
/monitor.json
/monitor.log
/monitor-history.jsonl
/monitor.lock
/monitor-launch.lock
/monitor-launch.json
/packaging/review-pack*/
/packaging/*.zip

.chart-data-*/
# Timestamped intermediate exports and temporary staging path lists.
/output/takehome-all-tasks-*.pptx
/output/takehome-rust-integration-*.pptx
/packaging/scoped-commit-paths-*.nul
