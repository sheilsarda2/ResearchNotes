# Fallback template — your workspace normally ships with .env already filled.
# If .env is missing:
# 1. Copy this file:            cp .env.example .env
# 2. Paste your personal token (starts with "thg_", printed in your PDF brief).
# 3. Open a NEW terminal in VS Code, then run:  bash scripts/doctor.sh
#
# .env is git-ignored — never commit it or share your token.
TAKE_HOME_TOKEN=thg_paste_your_token_here
