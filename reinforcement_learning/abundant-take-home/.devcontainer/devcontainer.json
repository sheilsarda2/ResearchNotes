{
  "name": "Abundant Take-Home",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },

  // Non-secret gateway config so ad-hoc scripts (anthropic SDK, curl) work in
  // any terminal. The secret token comes ONLY from the git-ignored .env —
  // deliberately no ${localEnv:...} anywhere in this file, so nothing from the
  // host environment (e.g. a personal ANTHROPIC_API_KEY) can leak in.
  "containerEnv": {
    "ANTHROPIC_BASE_URL": "https://take-home-automation.vercel.app",
    "ANTHROPIC_API_BASE": "https://take-home-automation.vercel.app",
    "TAKE_HOME_DEVCONTAINER": "1"
  },

  // harbor / uv land in ~/.local/bin; make them visible to VS Code tasks and
  // non-login shells, not just rc-file shells.
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "remoteUser": "vscode",

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",

  // harbor view binds 127.0.0.1 on the first free port in 8080-8089.
  "forwardPorts": [8080, 8081, 8082, 8083, 8084, 8085, 8086, 8087, 8088, 8089],
  "portsAttributes": {
    "8080-8089": { "label": "harbor view", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ]
    }
  },

  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" }
}
